# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.cache

# Local input, datasets, downloaded weights, and generated artifacts
/input/*
!/input/.gitkeep
/models/*
!/models/.gitkeep
/dataset/images/train/*
!/dataset/images/train/.gitkeep
/dataset/images/val/*
!/dataset/images/val/.gitkeep
/dataset/images/test/*
!/dataset/images/test/.gitkeep
/dataset/labels/train/*
!/dataset/labels/train/.gitkeep
/dataset/labels/val/*
!/dataset/labels/val/.gitkeep
/dataset/labels/test/*
!/dataset/labels/test/.gitkeep
/dataset_v2/
/output/*
!/output/.gitkeep
/expected-output/*
!/expected-output/.gitkeep
/runs/*
!/runs/.gitkeep
/annotation_batches/*
!/annotation_batches/.gitkeep

# Tool and operating-system files
.huggingface/
.DS_Store
Thumbs.db
.env
