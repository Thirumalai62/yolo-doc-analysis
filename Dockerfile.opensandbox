# syntax=docker/dockerfile:1
ARG BASE_IMAGE=python:3.13.13-slim-bookworm@sha256:355bfa66770995d7e9a0da4b3473b44d0cb451f6b56f5615ad9c39e3c4eca03f
ARG NODE_VERSION=22.2.0
ARG NODE_SHA256=3544eee9cb1414d6e9003efd56bc807ffb0f4445d2fc383e1df04c3e5e72c91b
ARG CLONE3_SHA256=c2c45ca59ac8033b9e52cd59896e0d2acec82468efbf5a0f668deedb862795d5

FROM debian:bookworm-slim AS runtime-assets

ARG NODE_VERSION
ARG NODE_SHA256
ARG CLONE3_SHA256

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSLo /tmp/node.tar.xz \
        "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
    && echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum -c - \
    && mkdir -p /opt/node \
    && tar -xJf /tmp/node.tar.xz -C /opt/node \
    && mv "/opt/node/node-v${NODE_VERSION}-linux-x64" "/opt/node/v${NODE_VERSION}" \
    && curl -fsSLo /usr/local/bin/clone3-workaround \
        https://github.com/AkihiroSuda/clone3-workaround/releases/download/v1.0.0/clone3-workaround.x86_64 \
    && echo "${CLONE3_SHA256}  /usr/local/bin/clone3-workaround" | sha256sum -c - \
    && chmod 755 /usr/local/bin/clone3-workaround

FROM ${BASE_IMAGE}

ARG PYTHON_VERSION=3.13
ARG NODE_VERSION=22.2.0
ARG TSLAB_VERSION=1.0.22

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV PYTHON_VERSION=${PYTHON_VERSION} \
    NODE_VERSION=22 \
    PATH=/opt/node/v${NODE_VERSION}/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin \
    JUPYTER_HOST=http://127.0.0.1:44771 \
    JUPYTER_PORT=44771 \
    PYTHONPATH=/opt/doc-detector \
    DOC_DETECTOR_MANIFEST=/opt/doc-detector/model-manifest.json \
    DOC_DETECTOR_OUTPUT_ROOT=/tmp/doc-detector/jobs \
    YOLO_CONFIG_DIR=/tmp/doc-detector/cache/ultralytics \
    MPLCONFIGDIR=/tmp/doc-detector/cache/matplotlib \
    XDG_CACHE_HOME=/tmp/doc-detector/cache \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY --from=runtime-assets /opt/node /opt/node
COPY --from=runtime-assets /usr/local/bin/clone3-workaround /usr/local/bin/clone3-workaround
COPY requirements-code-interpreter.lock /opt/doc-detector/requirements-code-interpreter.lock

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates libgl1 libglib2.0-0 libgomp1 libseccomp2 \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install \
        --break-system-packages \
        --no-cache-dir \
        --only-binary=:all: \
        --require-hashes \
        -r /opt/doc-detector/requirements-code-interpreter.lock \
    && npm install --global "tslab@${TSLAB_VERSION}" \
    && npm cache clean --force \
    && python -m ipykernel install --sys-prefix --name python --display-name Python \
    && python -m bash_kernel.install --sys-prefix \
    && tslab install --python python --sys-prefix --binary /opt/node/v22.2.0/bin/tslab \
    && python -m pip check \
    && node --version \
    && tslab --version \
    && rm -rf /root/.cache /root/.npm

COPY doc_detector /opt/doc-detector/doc_detector
COPY model-manifest.json /opt/doc-detector/model-manifest.json
COPY .build/opensandbox/legal_notice_r7.pt /opt/doc-detector/models/legal_notice_r7.pt
COPY scripts/code-interpreter-env.sh /opt/code-interpreter/code-interpreter-env.sh
COPY scripts/code-interpreter.sh /opt/code-interpreter/code-interpreter.sh

RUN chmod 755 \
        /opt/code-interpreter/code-interpreter-env.sh \
        /opt/code-interpreter/code-interpreter.sh \
    && ln -sf /opt/node/v22.2.0/bin/node /usr/local/bin/node \
    && ln -sf /opt/node/v22.2.0/bin/npm /usr/local/bin/npm \
    && ln -sf /opt/node/v22.2.0/bin/npx /usr/local/bin/npx \
    && ln -sf /opt/node/v22.2.0/bin/tslab /usr/local/bin/tslab \
    && mkdir -p \
        /tmp/doc-detector/jobs \
        /tmp/doc-detector/cache/ultralytics \
        /tmp/doc-detector/cache/matplotlib \
        /tmp/code-interpreter \
        /tmp/jupyter-runtime \
    && python -c "from doc_detector import get_detector; detector = get_detector(); detector.load(); print(detector.spec.version, detector.spec.sha256)"

LABEL org.opencontainers.image.title="Legal PDF Detector Code Interpreter" \
      org.opencontainers.image.description="Focused OpenSandbox-compatible Python and Node.js runtime" \
      org.opencontainers.image.runtime.languages="python-3.13,nodejs-22"

WORKDIR /workspace
ENTRYPOINT ["/opt/code-interpreter/code-interpreter.sh"]
